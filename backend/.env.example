# Application
DEBUG=true
SECRET_KEY=remplace-par-une-cle-aleatoire-longue

# Base de données (PostgreSQL)
DATABASE_URL=postgresql+psycopg://koulango:koulango@db:5432/koulango

# Recherche floue
SIMILARITY_THRESHOLD=0.3
LEVENSHTEIN_MAX_DISTANCE=3

# Stockage média (local | supabase | r2)
STORAGE_PROVIDER=local
STORAGE_BUCKET=koulango-media
STORAGE_PUBLIC_URL=

# Assistant conversationnel (API Claude) — laisser vide pour le désactiver
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_RATE_LIMIT_PER_HOUR=60
